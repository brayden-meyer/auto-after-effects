protocol=1
profile_id=soundkeys-custom
effect_match=tc Sound Keys
command_match=tc Sound Keys-0049
command_name=Commands
command_index=-1
mode=custom_event

contextless=1
release_drag=1
frame_left=UNRESOLVED
frame_top=UNRESOLVED
frame_width=UNRESOLVED
frame_height=UNRESOLVED
# Click offsets are relative to frame_left/top; the event carries their sum.
click_x=UNRESOLVED
click_y=UNRESOLVED

# List ONLY active Sound Keys ranges that the template requires. These are
# English output names resolved at runtime, not assumed native indices.
outputs=1
min_keys=2
max_keys=500000
start_tolerance_seconds=0.11
end_tolerance_seconds=0.11
max_gap_seconds=0.11
